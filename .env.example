# ============================================================
# MarketFish — LLM API Keys
# ============================================================
# Copy this file to .env and fill in YOUR keys.
# At least ONE provider is required. Add as many as you want —
# more providers = more diverse agent behaviors.
#
# Get keys here (click → create API key):
#   - DeepSeek:    https://platform.deepseek.com
#   - Qwen:        https://dashscope.aliyun.com
#   - Doubao:      https://console.volcengine.com
#   - Zhipu:       https://open.bigmodel.cn
#   - Baidu:       https://console.bce.baidu.com
#   - Hunyuan:     https://console.cloud.tencent.com
#   - OpenAI:      https://platform.openai.com
#   - Anthropic:   https://console.anthropic.com
#   - Google:      https://aistudio.google.com
#   - Mistral:     https://console.mistral.ai
#   - Meta:        https://llama-api.meta.com
#
# IMPORTANT: Start with just ONE key (DeepSeek is cheapest).
# The pipeline works with any single provider.

# ── Chinese LLMs ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
QIANWEN_API_KEY=sk-your-key-here
DOUBAO_API_KEY=your-key-here
ZHIPU_API_KEY=your-key-here
BAIDU_API_KEY=your-key-here
HUNYUAN_API_KEY=your-key-here

# ── International LLMs ────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-key-here
MISTRAL_API_KEY=your-key-here
META_API_KEY=your-key-here

# ── Seed Data Ingestion (optional) ───────────────────────────
# Without these, simulation uses static data — still works fine.
GITHUB_TOKEN=ghp_xxx
PRODUCTHUNT_TOKEN=xxx
STACKEXCHANGE_KEY=xxx
